# ============================================
# API ENDPOINTS - CONFIGURACIÓN (EJEMPLO)
# ============================================
# Copiar como .env y ajustar al entorno.
# Cada entorno puede tener diferentes valores.

# --- Empresa ---
API_ID_EMPRESA=1

# --- Categorías de clientes ---
# IDs separados por coma
API_CLIENTE_CATEGORIAS=2,7,15

# --- Categorías especiales ---
API_CAT_PREPAGO=3
API_CAT_CREDITO=5
API_CAT_CONTADO=10
API_CAT_BONIFICACION=51

# --- Facturas ---
# Tipos de pago a excluir (separados por coma)
API_FACTURA_TIPOPAGO_EXCLUIR=1,4,21,22
# Series válidas (separadas por coma)
API_FACTURAS_SERIES=C,N,P,R,D,H,FRF
# Fecha mínima por defecto
API_FACTURA_FECHA_MIN=2019-09-23
