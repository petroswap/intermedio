# ============================================
# MINI ADMIN v2 - VARIABLES DE ENTORNO
# ============================================
# Copiar como .env y ajustar al servidor.
# NUNCA subir .env al control de versiones.

# --- Entorno ---
APP_ENV=local
APP_DEBUG=true

# --- Base de Datos Firebird ---
DB_DRIVER=firebird
DB_SERVER=192.168.4.101
DB_PORT=3050
DB_PATH=C:\ALVIC5\BO5\FDB\BO5.FDB
DB_USER=SYSDBA
DB_PASSWORD=tu_password_aqui
DB_CHARSET=UTF8

# --- Base de Datos MySQL (opcional) ---
DB_MYSQL_HOST=localhost
DB_MYSQL_PORT=3306
DB_MYSQL_NAME=web_app
DB_MYSQL_USER=web_user
DB_MYSQL_PASSWORD=tu_password_mysql_aqui
