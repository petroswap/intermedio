# --- Aplicación ---
APP_NAME=Mini Admin v2
APP_VERSION=2.0.0
APP_BASE_URL=/intermedio/admin/
APP_ITEMS_PER_PAGE=25
APP_MAX_EXPORT=10000

# --- CORS ---
CORS_ORIGIN=*

